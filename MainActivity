package com.example.ex17;

import android.os.Bundle;
import android.view.View;
import android.widget.ArrayAdapter;
import android.widget.Spinner;
import android.widget.Toast;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;
import androidx.core.graphics.Insets;
import androidx.core.view.ViewCompat;
import androidx.core.view.WindowInsetsCompat;
import androidx.recyclerview.widget.GridLayoutManager;
import androidx.recyclerview.widget.RecyclerView;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Random;
import java.util.Set;

public class MainActivity extends AppCompatActivity {

    private Spinner spinner;
    private RecyclerView recycler;
    private List<PokemonInfo> lista;
    private Set<String> capturados;
    private Map<String, PokemonInfo> mapa;
    private AdapterPokemon adapter;
    private Random random = new Random();
    private String[] geracoes = {"Kato", "Johto", "Hoenn"};

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);
        setContentView(R.layout.activity_main);
        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.main), (v, insets) -> {
            Insets systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars());
            v.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom);
            return insets;
        });
        spinner = findViewById(R.id.spinnerGeracao);
        recycler = findViewById(R.id.recycler);
        capturados = new HashSet<>();
        mapa = new HashMap<>();
        lista = gerarCatalogo();
        adapter = new AdapterPokemon(capturados,lista, mapa);
        recycler.setLayoutManager(new GridLayoutManager (this, 3));
        recycler.setAdapter(adapter);
        spinner.setAdapter(new ArrayAdapter<>(this, android.R.layout.simple_spinner_item,geracoes));
    }

    private List<PokemonInfo> gerarCatalogo() {
        ArrayList<PokemonInfo> pokemons = new ArrayList<>();
        //KANTO
        pokemons.add(new PokemonInfo("Kanto", "Bulbasaur",1,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Ivysaur",2,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Venusaur",3,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Charmander",4,"Fogo"));
        pokemons.add(new PokemonInfo("Kanto", "Charmeleon",5,"Fogo"));
        pokemons.add(new PokemonInfo("Kanto", "Charizard",6,"Fogo/Voador"));
        pokemons.add(new PokemonInfo("Kanto", "Squirtle",7,"Agua"));
        pokemons.add(new PokemonInfo("Kanto", "Wartortle",8,"Agua"));
        pokemons.add(new PokemonInfo("Kanto", "Blastoise",9,"Agua"));
        //JOHTO
        pokemons.add(new PokemonInfo("Johto", "Bulbasaur",1,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Ivysaur",2,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Venusaur",3,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Charmander",4,"Fogo"));
        pokemons.add(new PokemonInfo("Kanto", "Charmeleon",5,"Fogo"));
        pokemons.add(new PokemonInfo("Kanto", "Charizard",6,"Fogo/Voador"));
        pokemons.add(new PokemonInfo("Kanto", "Squirtle",7,"Agua"));
        pokemons.add(new PokemonInfo("Kanto", "Wartortle",8,"Agua"));
        pokemons.add(new PokemonInfo("Kanto", "Blastoise",9,"Agua"));
        //HOENN
        pokemons.add(new PokemonInfo("Kanto", "Bulbasaur",1,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Ivysaur",2,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Venusaur",3,"Planta/Veneno"));
        pokemons.add(new PokemonInfo("Kanto", "Charmander",4,"Fogo"));
        pokemons.add(new PokemonInfo("Kanto", "Charmeleon",5,"Fogo"));
        pokemons.add(new PokemonInfo("Kanto", "Charizard",6,"Fogo/Voador"));
        pokemons.add(new PokemonInfo("Kanto", "Squirtle",7,"Agua"));
        pokemons.add(new PokemonInfo("Kanto", "Wartortle",8,"Agua"));
        pokemons.add(new PokemonInfo("Kanto", "Blastoise",9,"Agua"));
        for (PokemonInfo p: pokemons){
            mapa.put(p.getNome(), p);
        }
        return pokemons;
    }
    public void explorar(View v){
        String geracao = spinner.getSelectedItem().toString();
        ArrayList<PokemonInfo> pool = new ArrayList<>();
        for (PokemonInfo p: lista){
            if (p.getGeracao().equals(geracao)){
                pool.add(p);
            }
        }
        PokemonInfo sorteado = pool.get(random.nextInt(pool.size()));
        capturados.add(sorteado.getNome());
        sorteado.registrarEncontro();
        Toast.makeText(this, "Encontrou" + sorteado.getNome(), Toast.LENGTH_SHORT).show();
        adapter.notifyDataSetChanged();
    }
    public void rsestar(View v){
        capturados.clear();
        for(PokemonInfo p: lista){
            while (p.getEncontros() > 0){
                p.getEncontros();
                break;
            }
        }
        adapter.notifyDataSetChanged();
    }
    
}
