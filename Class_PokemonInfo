package com.example.ex17;

public class PokemonInfo {
    private  int numero,encontros;
    private String nome,tipo,geracao;

    public PokemonInfo(int numero, String nome, String tipo, String geracao) {
        this.numero = numero;
        this.nome = nome;
        this.tipo = tipo;
        this.geracao = geracao;
        encontros = 0;
    }

    public int getNumero() {
        return numero;
    }

    public int getEncontros() {
        return encontros;
    }

    public String getNome() {
        return nome;
    }

    public String getTipo() {
        return tipo;
    }

    public String getGeracao() {
        return geracao;
    }
    public void registrarEncontro(){
        encontros++;
    }
}
